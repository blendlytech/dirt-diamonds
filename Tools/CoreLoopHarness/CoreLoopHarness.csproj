<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DirtAndDiamonds.Tools.CoreLoopHarness</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Same trick as SchemaValidator: compile the game's headless core directly
      instead of referencing the Godot assembly. GameManager.cs is excluded
      because it is the one deliberately Godot-facing file in Assets/Core —
      if an engine type leaks into anything else here, this project stops
      building and the headless exit-criteria run is impossible.
    -->
    <Compile Include="..\..\Assets\Data\Database\*.cs" Link="Data\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Core\*.cs" Exclude="..\..\Assets\Core\GameManager.cs" Link="Core\%(Filename)%(Extension)" />
    <!--
      13-4: the postseason clock fixtures (the clock stops on the avatar's
      postseason game day; a reload mid-series resumes the same fixture; an
      eliminated avatar gets free sliders) drive the real career driver and
      PlayoffManager, so the headless Baseball sim compiles in here too, the
      same way MonteCarloHarness compiles it.
    -->
    <Compile Include="..\..\Assets\Data\League\*.cs" Link="Data\League\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Data\Schools\*.cs" Link="Data\Schools\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Simulation\Baseball\*.cs" Link="Baseball\%(Filename)%(Extension)" />
    <!-- 13-5: the coach-beat writer (Narrative, Godot-free: Core events and the Data layer only). -->
    <Compile Include="..\..\Assets\Narrative\Roster\*.cs" Link="Narrative\Roster\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
